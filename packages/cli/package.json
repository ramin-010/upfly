{
  "name": "upfly",
  "version": "0.0.0",
  "description": "Optimize your repo's images without breaking a reference.",
  "license": "MIT",
  "author": "Rinkal Kumar (https://github.com/ramin-010)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramin-010/upfly.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "image",
    "optimize",
    "webp",
    "avif",
    "codemod",
    "refactor",
    "cli",
    "lighthouse",
    "core-web-vitals"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "upfly": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist/", "README.md", "AGENTS.md", "LICENSE"],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@upfly/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
