{
  "name": "upfly-bench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Performance measurements for upfly-core. Every number in the README comes from here.",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "bench": "tsc --build && node dist/run.js",
    "validate": "tsc --build && node dist/validate.js",
    "detect-roots": "tsc --build && node dist/detect-roots.js",
    "corpus-run": "tsc --build && node dist/corpus-run.js",
    "dead-rate": "tsc --build && node dist/dead-rate.js",
    "fixture-build": "tsc --build && node dist/fixture-build.js",
    "encode-quality": "tsc --build && node dist/encode-quality.js",
    "move-run": "tsc --build && node dist/move-run.js"
  },
  "dependencies": {
    "sharp": "^0.35.4",
    "upfly-core": "workspace:*"
  }
}
