{
  "name": "upfly-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --build --force && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm comments:check && pnpm typecheck && pnpm test",
    "comments:check": "node tools/comment-check.mjs",
    "comments:baseline": "node tools/comment-check.mjs --update",
    "bench": "pnpm --filter upfly-bench run bench",
    "bench:gate": "pnpm --filter upfly-bench run bench -- --graph-only --invocations=3 --runs=3",
    "validate": "pnpm --filter upfly-bench run validate",
    "coverage-tree:check": "node coverage-tree/tools/check-key.mjs --strict",
    "coverage-tree:prove": "node coverage-tree/tools/prove-can-fail.mjs",
    "coverage-tree:measure": "pnpm build && pnpm --filter upfly-bench run build && node coverage-tree/tools/measure.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.10",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
